rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(workspaceId, userId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId); }
    function hasActiveMembership(workspaceId) { return signedIn() && exists(memberPath(workspaceId, request.auth.uid)) && get(memberPath(workspaceId, request.auth.uid)).data.status == 'active'; }
    function hasRole(workspaceId, role) { return hasActiveMembership(workspaceId) && get(memberPath(workspaceId, request.auth.uid)).data.role == role; }
    function isOwner(workspaceId) { return hasRole(workspaceId, 'owner'); }
    function isAdmin(workspaceId) { return hasRole(workspaceId, 'admin'); }
    function isManager(workspaceId) { return hasRole(workspaceId, 'manager'); }
    function canApproveMembers(workspaceId) { return isOwner(workspaceId) || isAdmin(workspaceId) || isManager(workspaceId); }
    function canManage(workspaceId) { return isOwner(workspaceId) || isAdmin(workspaceId); }
    function canOperate(workspaceId) { return isOwner(workspaceId) || isAdmin(workspaceId) || isManager(workspaceId); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canManage(workspaceId);
      allow delete: if false;

      match /members/{memberId} {
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.status == 'pending';

        allow read: if signedIn()
          && (request.auth.uid == memberId || canApproveMembers(workspaceId));

        allow update: if canApproveMembers(workspaceId)
          && memberId != request.auth.uid;

        allow delete: if false;
      }

      match /invitations/{invitationId} {
        allow create: if canApproveMembers(workspaceId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.token == invitationId
          && request.resource.data.role in ['admin', 'manager', 'member', 'intern', 'viewer']
          && request.resource.data.status == 'pending';

        // A bearer invitation token is the credential for this single-document lookup.
        // Only the matching token document may be retrieved, and only while it is active.
        allow get: if resource.data.workspaceId == workspaceId
          && resource.data.token == invitationId
          && resource.data.status == 'pending'
          && resource.data.expiresAt > request.time;

        allow list: if canApproveMembers(workspaceId);

        allow update: if (
            canApproveMembers(workspaceId)
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
          ) || (
            signedIn()
            && resource.data.workspaceId == workspaceId
            && resource.data.token == invitationId
            && resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
            && (resource.data.email == null || resource.data.email == request.auth.token.email)
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          );

        allow delete: if false;
      }
    }

    match /websites/{websiteId} {
      allow create: if signedIn()
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId != ''
        && canOperate(request.resource.data.workspaceId);
      allow read: if hasActiveMembership(resource.data.workspaceId);
      allow update: if canOperate(resource.data.workspaceId)
        && resource.data.workspaceId == request.resource.data.workspaceId;
      allow delete: if canManage(resource.data.workspaceId);
    }

    match /clients/{clientId} {
      allow create: if signedIn()
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId != ''
        && canOperate(request.resource.data.workspaceId);
      allow read: if hasActiveMembership(resource.data.workspaceId);
      allow update: if canOperate(resource.data.workspaceId)
        && resource.data.workspaceId == request.resource.data.workspaceId;
      allow delete: if canManage(resource.data.workspaceId);
    }

    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId != ''
        && canOperate(request.resource.data.workspaceId);

      allow read: if hasActiveMembership(resource.data.workspaceId)
        && (
          get(memberPath(resource.data.workspaceId, request.auth.uid)).data.role != 'intern'
          || resource.data.ownerId == request.auth.uid
        );

      allow update: if resource.data.workspaceId == request.resource.data.workspaceId
        && (
          canOperate(resource.data.workspaceId)
          || (
            hasActiveMembership(resource.data.workspaceId)
            && get(memberPath(resource.data.workspaceId, request.auth.uid)).data.role in ['member', 'intern']
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );

      allow delete: if canManage(resource.data.workspaceId);
    }

    match /tasks/{taskId} {
      allow create: if signedIn()
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId != ''
        && request.resource.data.createdBy == request.auth.uid
        && canOperate(request.resource.data.workspaceId);

      allow read: if hasActiveMembership(resource.data.workspaceId)
        && (
          get(memberPath(resource.data.workspaceId, request.auth.uid)).data.role != 'intern'
          || resource.data.assigneeId == request.auth.uid
        );

      allow update: if resource.data.workspaceId == request.resource.data.workspaceId
        && (
          canOperate(resource.data.workspaceId)
          || (
            hasActiveMembership(resource.data.workspaceId)
            && get(memberPath(resource.data.workspaceId, request.auth.uid)).data.role in ['member', 'intern']
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.assigneeId == resource.data.assigneeId
          )
        );

      allow delete: if canOperate(resource.data.workspaceId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
