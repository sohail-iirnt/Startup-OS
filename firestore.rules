rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(workspaceId, userId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId); }
    function workspacePath(workspaceId) { return /databases/$(database)/documents/workspaces/$(workspaceId); }
    function hasMembership(workspaceId) { return signedIn() && exists(memberPath(workspaceId, request.auth.uid)); }
    function hasActiveMembership(workspaceId) { return hasMembership(workspaceId) && get(memberPath(workspaceId, request.auth.uid)).data.status == 'active'; }
    function isWorkspaceOwner(workspaceId) { return signedIn() && exists(workspacePath(workspaceId)) && get(workspacePath(workspaceId)).data.ownerId == request.auth.uid; }
    function userRole(workspaceId) { return get(memberPath(workspaceId, request.auth.uid)).data.role; }
    function normalizedRole(workspaceId) { return userRole(workspaceId) == 'Owner' ? 'owner' : userRole(workspaceId) == 'Admin' ? 'admin' : userRole(workspaceId) == 'administrator' ? 'admin' : userRole(workspaceId) == 'Administrator' ? 'admin' : userRole(workspaceId) == 'Manager' ? 'manager' : userRole(workspaceId) == 'Member' ? 'member' : userRole(workspaceId) == 'Intern' ? 'intern' : userRole(workspaceId) == 'Viewer' ? 'viewer' : userRole(workspaceId); }
    function hasRole(workspaceId, role) { return hasActiveMembership(workspaceId) && normalizedRole(workspaceId) == role; }
    function hasAnyRole(workspaceId, roles) { return hasActiveMembership(workspaceId) && normalizedRole(workspaceId) in roles; }
    function isOwner(workspaceId) { return isWorkspaceOwner(workspaceId) || hasRole(workspaceId, 'owner'); }
    function isAdmin(workspaceId) { return hasRole(workspaceId, 'admin'); }
    function isWorkspaceAdmin(workspaceId) { return isOwner(workspaceId) || isAdmin(workspaceId); }
    function canApproveMembers(workspaceId) { return hasPermission(workspaceId, 'members.approve'); }
    function canManage(workspaceId) { return isWorkspaceAdmin(workspaceId); }
    function canCreateTasks(workspaceId) { return hasPermission(workspaceId, 'tasks.create'); }
    function canCreateProjects(workspaceId) { return hasPermission(workspaceId, 'projects.create'); }
    function canInviteRole(workspaceId, role) { return isWorkspaceAdmin(workspaceId) ? role in ['admin', 'manager', 'member', 'intern', 'viewer'] : role in ['member', 'intern', 'viewer']; }
    function hasPermission(workspaceId, permission) {
      return signedIn() && (isWorkspaceAdmin(workspaceId) ||
        (hasActiveMembership(workspaceId) && (
          (permission == 'workspace.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'members.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'members.approve' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'projects.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'projects.create' && normalizedRole(workspaceId) in ['manager','intern']) ||
          (permission == 'projects.update' && normalizedRole(workspaceId) in ['manager','member','intern']) ||
          (permission == 'tasks.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'tasks.create' && normalizedRole(workspaceId) in ['manager','member']) ||
          (permission == 'tasks.update' && normalizedRole(workspaceId) in ['manager','member','intern']) ||
          (permission == 'tasks.delete' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'clients.view' && normalizedRole(workspaceId) in ['manager','member','viewer']) ||
          (permission == 'clients.manage' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'websites.view' && normalizedRole(workspaceId) in ['manager','member','viewer']) ||
          (permission == 'websites.manage' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'calendar.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'calendar.manage' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'ideas.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'ideas.manage' && normalizedRole(workspaceId) in ['manager','member','intern']) ||
          (permission == 'documents.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'documents.manage' && normalizedRole(workspaceId) in ['manager','member','intern']) ||
          (permission == 'goals.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'goals.manage' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'analytics.view' && normalizedRole(workspaceId) in ['manager','member','viewer']) ||
          (permission == 'attendance.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'attendance.manage' && normalizedRole(workspaceId) == 'manager') ||
          (permission == 'leave.view' && normalizedRole(workspaceId) in ['manager','member','intern','viewer']) ||
          (permission == 'leave.manage' && normalizedRole(workspaceId) == 'manager') ||
          (!(permission in ['members.manage', 'access.manage', 'settings.manage']) && get(memberPath(workspaceId, request.auth.uid)).data.grantedPermissions != null && permission in get(memberPath(workspaceId, request.auth.uid)).data.grantedPermissions)
        ))
      ) && !(hasActiveMembership(workspaceId) && !isWorkspaceAdmin(workspaceId) && get(memberPath(workspaceId, request.auth.uid)).data.deniedPermissions != null && permission in get(memberPath(workspaceId, request.auth.uid)).data.deniedPermissions);
    }
    function canUpdateOwnTask(workspaceId, taskId) { return hasActiveMembership(workspaceId) && normalizedRole(workspaceId) == 'intern' && get(/databases/$(database)/documents/tasks/$(taskId)).data.assigneeId == request.auth.uid && hasPermission(workspaceId, 'tasks.update'); }
    function canUpdateOwnProject(workspaceId, projectId) { return hasActiveMembership(workspaceId) && normalizedRole(workspaceId) == 'intern' && hasPermission(workspaceId, 'projects.update') && ((get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid) || (get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAll(['memberIds']) && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds)); }
    function canApproveMemberUpdate(workspaceId) { return canApproveMembers(workspaceId) && request.resource.data.role in (isWorkspaceAdmin(workspaceId) ? ['admin', 'manager', 'member', 'intern', 'viewer'] : ['member', 'intern', 'viewer']) && request.resource.data.status == 'active'; }

    match /users/{userId} { allow read: if signedIn(); allow create, update: if signedIn() && request.auth.uid == userId; allow delete: if false; }
    match /workspaces/{workspaceId} {
      allow read: if hasMembership(workspaceId) || isWorkspaceOwner(workspaceId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canManage(workspaceId); allow delete: if false;
      match /members/{memberId} {
        allow create: if signedIn() && request.auth.uid == memberId && request.resource.data.userId == request.auth.uid && request.resource.data.workspaceId == workspaceId && request.resource.data.status == 'pending';
        allow read: if signedIn() && (request.auth.uid == memberId || isWorkspaceAdmin(workspaceId) || hasAnyRole(workspaceId, ['manager', 'member']));
        allow update: if memberId != request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.workspaceId == resource.data.workspaceId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'designation', 'status', 'updatedAt', 'grantedPermissions', 'deniedPermissions', 'joinedAt']) && (canManage(workspaceId) || (canApproveMemberUpdate(workspaceId) && resource.data.status == 'pending'));
        allow delete: if false;
      }
      match /invitations/{invitationId} {
        allow create: if canApproveMembers(workspaceId) && canInviteRole(workspaceId, request.resource.data.role) && request.resource.data.workspaceId == workspaceId && request.resource.data.createdBy == request.auth.uid && request.resource.data.token == invitationId && request.resource.data.status == 'pending';
        allow get: if resource.data.workspaceId == workspaceId && resource.data.token == invitationId && resource.data.status == 'pending' && resource.data.expiresAt > request.time && (resource.data.email == null || resource.data.email == request.auth.token.email || canApproveMembers(workspaceId));
        allow list: if canApproveMembers(workspaceId);
        allow update: if (canApproveMembers(workspaceId) && request.resource.data.workspaceId == resource.data.workspaceId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])) || (signedIn() && resource.data.workspaceId == workspaceId && resource.data.token == invitationId && resource.data.status == 'pending' && resource.data.expiresAt > request.time && (resource.data.email == null || resource.data.email == request.auth.token.email) && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']));
        allow delete: if false;
      }
    }
    match /financeEntries/{entryId} { allow create: if signedIn() && request.resource.data.workspaceId is string && hasPermission(request.resource.data.workspaceId, 'finance.manage') && request.resource.data.createdBy == request.auth.uid && request.resource.data.type in ['income', 'expense', 'payroll'] && request.resource.data.amount > 0; allow read: if hasPermission(resource.data.workspaceId, 'finance.view'); allow update: if hasPermission(resource.data.workspaceId, 'finance.manage') && resource.data.workspaceId == request.resource.data.workspaceId; allow delete: if hasPermission(resource.data.workspaceId, 'finance.manage'); }
    match /calendarEvents/{eventId} { allow create: if signedIn() && request.resource.data.workspaceId is string && hasPermission(request.resource.data.workspaceId, 'calendar.manage') && request.resource.data.createdBy == request.auth.uid; allow read: if hasPermission(resource.data.workspaceId, 'calendar.view'); allow update: if hasPermission(request.resource.data.workspaceId, 'calendar.manage') && resource.data.workspaceId == request.resource.data.workspaceId; allow delete: if hasPermission(resource.data.workspaceId, 'calendar.manage'); }
    match /websites/{websiteId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && hasPermission(request.resource.data.workspaceId, 'websites.manage'); allow read: if hasPermission(resource.data.workspaceId, 'websites.view'); allow update: if hasPermission(request.resource.data.workspaceId, 'websites.manage') && resource.data.workspaceId == request.resource.data.workspaceId; allow delete: if hasPermission(resource.data.workspaceId, 'websites.manage'); }
    match /clients/{clientId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && hasPermission(request.resource.data.workspaceId, 'clients.manage'); allow read: if hasPermission(resource.data.workspaceId, 'clients.view'); allow update: if hasPermission(resource.data.workspaceId, 'clients.manage'); allow delete: if hasPermission(resource.data.workspaceId, 'clients.manage'); }
    match /ideas/{ideaId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && hasPermission(request.resource.data.workspaceId, 'ideas.manage') && request.resource.data.createdBy == request.auth.uid; allow read: if hasPermission(resource.data.workspaceId, 'ideas.view'); allow update: if hasPermission(resource.data.workspaceId, 'ideas.manage') && resource.data.workspaceId == request.resource.data.workspaceId; allow delete: if hasPermission(resource.data.workspaceId, 'ideas.manage'); }
    match /documents/{documentId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && hasPermission(request.resource.data.workspaceId, 'documents.manage') && request.resource.data.createdBy == request.auth.uid; allow read: if hasPermission(resource.data.workspaceId, 'documents.view'); allow update: if hasPermission(request.resource.data.workspaceId, 'documents.manage') && resource.data.workspaceId == request.resource.data.workspaceId; allow delete: if hasPermission(resource.data.workspaceId, 'documents.manage'); }
    match /goals/{goalId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && hasPermission(request.resource.data.workspaceId, 'goals.manage') && request.resource.data.createdBy == request.auth.uid; allow read: if hasPermission(resource.data.workspaceId, 'goals.view'); allow update: if hasPermission(resource.data.workspaceId, 'goals.manage'); allow delete: if hasPermission(resource.data.workspaceId, 'goals.manage'); }
    match /projects/{projectId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && canCreateProjects(request.resource.data.workspaceId) && (normalizedRole(request.resource.data.workspaceId) != 'intern' || (request.resource.data.ownerId == request.auth.uid && request.resource.data.memberIds is list && request.auth.uid in request.resource.data.memberIds)); allow read: if (normalizedRole(resource.data.workspaceId) == 'intern' ? ((resource.data.ownerId == request.auth.uid) || (resource.data.keys().hasAll(['memberIds']) && request.auth.uid in resource.data.memberIds)) : hasPermission(resource.data.workspaceId, 'projects.view')); allow update: if resource.data.workspaceId == request.resource.data.workspaceId && (normalizedRole(resource.data.workspaceId) == 'intern' ? canUpdateOwnProject(resource.data.workspaceId, projectId) : hasPermission(resource.data.workspaceId, 'projects.update')); allow delete: if hasPermission(resource.data.workspaceId, 'projects.delete'); }
    match /tasks/{taskId} { allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && request.resource.data.createdBy == request.auth.uid && canCreateTasks(request.resource.data.workspaceId); allow read: if (normalizedRole(resource.data.workspaceId) == 'intern' ? resource.data.assigneeId == request.auth.uid : hasPermission(resource.data.workspaceId, 'tasks.view')); allow update: if resource.data.workspaceId == request.resource.data.workspaceId && (normalizedRole(resource.data.workspaceId) == 'intern' ? canUpdateOwnTask(resource.data.workspaceId, taskId) : hasPermission(resource.data.workspaceId, 'tasks.update')); allow delete: if hasPermission(resource.data.workspaceId, 'tasks.delete'); }
    match /attendanceRecords/{recordId} {
      allow read: if signedIn() && (isWorkspaceOwner(resource.data.workspaceId) || (hasActiveMembership(resource.data.workspaceId) && normalizedRole(resource.data.workspaceId) == 'admin') || (resource.data.userId == request.auth.uid && hasPermission(resource.data.workspaceId, 'attendance.view')));
      allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.userId is string && request.resource.data.date is string && request.resource.data.status in ['present','late','half-day','absent','leave'] && (isWorkspaceOwner(request.resource.data.workspaceId) || (hasActiveMembership(request.resource.data.workspaceId) && normalizedRole(request.resource.data.workspaceId) == 'admin') || hasPermission(request.resource.data.workspaceId, 'attendance.manage') || (request.resource.data.userId == request.auth.uid && hasPermission(request.resource.data.workspaceId, 'attendance.view')));
      allow update: if signedIn() && resource.data.workspaceId == request.resource.data.workspaceId && (isWorkspaceOwner(resource.data.workspaceId) || (hasActiveMembership(resource.data.workspaceId) && normalizedRole(resource.data.workspaceId) == 'admin') || hasPermission(resource.data.workspaceId, 'attendance.manage') || (resource.data.userId == request.auth.uid && hasPermission(resource.data.workspaceId, 'attendance.view')));
      allow delete: if signedIn() && (isWorkspaceOwner(resource.data.workspaceId) || (hasActiveMembership(resource.data.workspaceId) && normalizedRole(resource.data.workspaceId) == 'admin') || hasPermission(resource.data.workspaceId, 'attendance.manage'));
    }
    match /leaveRequests/{leaveId} {
      allow read: if signedIn() && (isWorkspaceOwner(resource.data.workspaceId) || (hasActiveMembership(resource.data.workspaceId) && normalizedRole(resource.data.workspaceId) == 'admin') || (resource.data.userId == request.auth.uid && hasPermission(resource.data.workspaceId, 'leave.view')));
      allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending' && hasPermission(request.resource.data.workspaceId, 'leave.view');
      allow update: if signedIn() && resource.data.workspaceId == request.resource.data.workspaceId && (isWorkspaceOwner(resource.data.workspaceId) || (hasActiveMembership(resource.data.workspaceId) && normalizedRole(resource.data.workspaceId) == 'admin') || hasPermission(resource.data.workspaceId, 'leave.manage') || (resource.data.userId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])));
      allow delete: if signedIn() && (isWorkspaceOwner(resource.data.workspaceId) || (hasActiveMembership(resource.data.workspaceId) && normalizedRole(resource.data.workspaceId) == 'admin') || hasPermission(resource.data.workspaceId, 'leave.manage'));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
