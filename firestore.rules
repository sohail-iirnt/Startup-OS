rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(workspaceId, userId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId); }
    function hasActiveMembership(workspaceId) { return signedIn() && exists(memberPath(workspaceId, request.auth.uid)) && get(memberPath(workspaceId, request.auth.uid)).data.status == 'active'; }
    function userRole(workspaceId) { return get(memberPath(workspaceId, request.auth.uid)).data.role; }
    function hasRole(workspaceId, role) { return hasActiveMembership(workspaceId) && userRole(workspaceId) == role; }
    function hasAnyRole(workspaceId, roles) { return hasActiveMembership(workspaceId) && userRole(workspaceId) in roles; }
    function isOwner(workspaceId) { return hasRole(workspaceId, 'owner'); }
    function isAdmin(workspaceId) { return hasRole(workspaceId, 'admin'); }
    function canApproveMembers(workspaceId) { return hasAnyRole(workspaceId, ['owner', 'admin', 'manager']); }
    function canManage(workspaceId) { return hasAnyRole(workspaceId, ['owner', 'admin']); }
    function canOperate(workspaceId) { return hasAnyRole(workspaceId, ['owner', 'admin', 'manager']); }
    function canManageTasks(workspaceId) { return hasAnyRole(workspaceId, ['owner', 'admin', 'manager']); }
    function canCreateTasks(workspaceId) { return hasAnyRole(workspaceId, ['owner', 'admin', 'manager', 'member']); }
    function canUpdateOwnTask(workspaceId, taskId) { return hasActiveMembership(workspaceId) && userRole(workspaceId) in ['member', 'intern'] && get(/databases/$(database)/documents/tasks/$(taskId)).data.assigneeId == request.auth.uid; }
    function canUpdateOwnProject(workspaceId, projectId) { return hasActiveMembership(workspaceId) && userRole(workspaceId) == 'intern' && (get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds); }
    function canApproveMemberUpdate(workspaceId) {
      return canApproveMembers(workspaceId)
        && request.resource.data.role in (isOwner(workspaceId) || isAdmin(workspaceId) ? ['admin', 'manager', 'member', 'intern', 'viewer'] : ['member', 'intern', 'viewer'])
        && request.resource.data.status == 'active';
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if hasActiveMembership(workspaceId) || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canManage(workspaceId);
      allow delete: if false;

      match /members/{memberId} {
        allow create: if signedIn() && request.auth.uid == memberId && request.resource.data.userId == request.auth.uid && request.resource.data.workspaceId == workspaceId && request.resource.data.status == 'pending';
        allow read: if signedIn() && (request.auth.uid == memberId || canApproveMembers(workspaceId));
        allow update: if memberId != request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.workspaceId == resource.data.workspaceId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'designation', 'status', 'updatedAt']) && (canManage(workspaceId) || (canApproveMemberUpdate(workspaceId) && resource.data.status == 'pending'));
        allow delete: if false;
      }

      match /invitations/{invitationId} {
        allow create: if canApproveMembers(workspaceId) && request.resource.data.workspaceId == workspaceId && request.resource.data.createdBy == request.auth.uid && request.resource.data.token == invitationId && request.resource.data.role in ['admin', 'manager', 'member', 'intern', 'viewer'] && request.resource.data.status == 'pending';
        allow get: if resource.data.workspaceId == workspaceId && resource.data.token == invitationId && resource.data.status == 'pending' && resource.data.expiresAt > request.time;
        allow list: if canApproveMembers(workspaceId);
        allow update: if (canApproveMembers(workspaceId) && request.resource.data.workspaceId == resource.data.workspaceId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])) || (signedIn() && resource.data.workspaceId == workspaceId && resource.data.token == invitationId && resource.data.status == 'pending' && resource.data.expiresAt > request.time && (resource.data.email == null || resource.data.email == request.auth.token.email) && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']));
        allow delete: if false;
      }
    }

    match /financeEntries/{entryId} {
      allow create: if signedIn() && request.resource.data.workspaceId is string && canManage(request.resource.data.workspaceId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.type in ['income', 'expense'] && request.resource.data.amount > 0;
      allow read: if hasAnyRole(resource.data.workspaceId, ['owner', 'admin']);
      allow update: if canManage(resource.data.workspaceId) && resource.data.workspaceId == request.resource.data.workspaceId;
      allow delete: if canManage(resource.data.workspaceId);
    }

    match /calendarEvents/{eventId} {
      allow create: if signedIn() && request.resource.data.workspaceId is string && canOperate(request.resource.data.workspaceId) && request.resource.data.createdBy == request.auth.uid;
      allow read: if hasActiveMembership(resource.data.workspaceId);
      allow update: if canOperate(resource.data.workspaceId) && resource.data.workspaceId == request.resource.data.workspaceId;
      allow delete: if canOperate(resource.data.workspaceId);
    }

    match /websites/{websiteId} {
      allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && canOperate(request.resource.data.workspaceId);
      allow read: if hasAnyRole(resource.data.workspaceId, ['owner', 'admin', 'manager', 'member', 'viewer']);
      allow update: if canOperate(resource.data.workspaceId) && resource.data.workspaceId == request.resource.data.workspaceId;
      allow delete: if canManage(resource.data.workspaceId);
    }

    match /clients/{clientId} {
      allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && canOperate(request.resource.data.workspaceId);
      allow read: if hasAnyRole(resource.data.workspaceId, ['owner', 'admin', 'manager', 'member', 'viewer']);
      allow update: if canOperate(resource.data.workspaceId) && resource.data.workspaceId == request.resource.data.workspaceId;
      allow delete: if canManage(resource.data.workspaceId);
    }

    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && canOperate(request.resource.data.workspaceId);
      allow read: if hasAnyRole(resource.data.workspaceId, ['owner', 'admin', 'manager', 'member', 'viewer']) || (hasRole(resource.data.workspaceId, 'intern') && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.memberIds));
      allow update: if resource.data.workspaceId == request.resource.data.workspaceId && (canOperate(resource.data.workspaceId) || canUpdateOwnProject(resource.data.workspaceId, projectId));
      allow delete: if canManage(resource.data.workspaceId);
    }

    match /tasks/{taskId} {
      allow create: if signedIn() && request.resource.data.workspaceId is string && request.resource.data.workspaceId != '' && request.resource.data.createdBy == request.auth.uid && canCreateTasks(request.resource.data.workspaceId);
      allow read: if hasAnyRole(resource.data.workspaceId, ['owner', 'admin', 'manager', 'member', 'viewer']) || (hasRole(resource.data.workspaceId, 'intern') && resource.data.assigneeId == request.auth.uid);
      allow update: if resource.data.workspaceId == request.resource.data.workspaceId && (canManageTasks(resource.data.workspaceId) || canUpdateOwnTask(resource.data.workspaceId, taskId));
      allow delete: if canManageTasks(resource.data.workspaceId);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
